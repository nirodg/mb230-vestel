# OpenTV U-Boot diagnostics probe  --  NON-DESTRUCTIVE / READ-ONLY
#
# Deploy as <FAT32 stick root>/kylo_usb_update.scr, boot holding OK.
# U-Boot (NT72671, 2016.07) sources this plain-text script. It contains
# NO nand/sf ERASE or WRITE and NO nwriteloader/trimffs: it only reads
# flash into RAM and writes result files BACK TO THE USB STICK via
# fatwrite. Nothing touches the TV's NAND/SPI. Pull the stick, read the
# dump_*.bin / *.txt files on a PC. If the format is bad U-Boot aborts
# with no effect. CONFIRMED to execute on hardware 2026-11-12.
#
# RAM scratch 0x3300000 = DRAM load area the stock update script uses.
# NAND offsets are raw mtd0 offsets from the live `mtdparts` env.

echo OPENTV-PROBE: begin

# 0) marker: proves a custom .scr ran at all ("NVOK")
mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 opentv_probe_ran.bin 4

# 1) live U-Boot environment (text)
env export -t -s 0x8000 0x3310000
fatwrite usb 0:auto 0x3310000 opentv_uboot_env.txt 0x8000

# 2) xbootdat (recovery kernel cmdline / boot params) @0x2c0000, 8 KiB
nand read 0x3300000 0x2c0000 0x2000
fatwrite usb 0:auto 0x3300000 dump_xbootdat.bin 0x2000

# 3) npt (NAND partition table) @0x400000, 4 KiB
nand read 0x3300000 0x400000 0x1000
fatwrite usb 0:auto 0x3300000 dump_npt.bin 0x1000

# 4) misc @0x4c0000, 4 KiB
nand read 0x3300000 0x4c0000 0x1000
fatwrite usb 0:auto 0x3300000 dump_misc.bin 0x1000

# 5) SPI NOR config region 0x0..0x20000 (MAC / panel / config), 128 KiB
sf probe 0
sf read 0x3300000 0x0 0x20000
fatwrite usb 0:auto 0x3300000 dump_spi_0_20000.bin 0x20000

echo OPENTV-PROBE: done
%
