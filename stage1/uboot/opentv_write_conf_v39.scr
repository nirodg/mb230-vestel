# OpenTV /conf WRITE v3.9 (full liveness idtv via stock run_aurora.sh normal path)
# *** ARMED: WRITES TV FLASH ***
#
# v3.6-v3.8: exec'd aurora directly -> semaphore done but aurora exited mid-startup
# (PRIVSERVER.CB flood -> watchdog). Stock debug ini launches run_aurora.sh; its
# non-remote else branch runs $PWD/com.nvt.idtv/aurora.elf normally. remote.txt on
# /conf would trigger the remote-debug branch, so v3.9 temporarily hides remote.txt,
# execs /mtd_apexe/board/run_aurora.sh (normal path), and a bg keeper restores
# remote.txt after startup and snapshots /tmp/stdout.all for diagnosis.
# Goal: stable system + persistent root shell (:23) on a fully-live idtv.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v39.ubifs (3,809,280 B = 0x3a2000, crc32 e0d6f210).

echo OPENTV-CONFV39: begin (ARMED, conf <- conf_v39.ubifs liveness v39)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv39_began.bin 4

fatload usb 0:auto 0x3300000 conf_v39.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 e0d6f210; then
    echo OPENTV-CONFV39: VERIFIED (crc32 e0d6f210)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v39_conf_ok.bin 4
else
    echo OPENTV-CONFV39: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v39_conf_FAIL.bin 4
fi

echo OPENTV-CONFV39: done
% <- this is end of file symbol
