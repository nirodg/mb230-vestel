# OpenTV /conf WRITE v3.11 (ROOT-CAUSE FIX: restore stock env before aurora exec)
# *** ARMED: WRITES TV FLASH ***
#
# UART caught the v3.6-v3.10 crash: FATAL:base_paths_tvsdk.cc(72) "browser_dir =
# /mtd_apexe/board/com.nvt.idtv/browser_dir directory does not exist!" + "$HOME is
# not set" -> aurora SIGABRT -> "Restart system..." -> watchdog reboot loop.
# Root cause: ap0 shim execs /bin/sh WITHOUT environ, so aurora ran with an empty
# environment (no BROWSER_DIR=/vendor/browser_dir, WORKING_PATH, DFBHOME, ...).
# v3.11: wrapper restores the full run.sh export block ($PWD=/vendor, then-branch,
# NVT_APP_INI=nvt.app.debug.ini) before exec'ing aurora directly as idtv.
# Keeper (telnetd + /tmp/stdout.all capture) unchanged.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v311.ubifs (3,809,280 B = 0x3a2000, crc32 1f51c99).

echo OPENTV-CONFV311: begin (ARMED, conf <- conf_v311.ubifs env-fix)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv311_began.bin 4

fatload usb 0:auto 0x3300000 conf_v311.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 1f51c99; then
    echo OPENTV-CONFV311: VERIFIED (crc32 1f51c99)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v311_conf_ok.bin 4
else
    echo OPENTV-CONFV311: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v311_conf_FAIL.bin 4
fi

echo OPENTV-CONFV311: done
% <- this is end of file symbol
