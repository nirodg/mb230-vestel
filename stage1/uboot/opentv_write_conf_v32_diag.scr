# OpenTV /conf WRITE v3.2 (diagnostic wrapper)  --  *** ARMED: WRITES TV FLASH ***
#
# Purpose: payload v3.1 binary is on /conf (0755, correct, static ARM)
# and appmgr execs it, but it produced ZERO logs — so either exec
# fails or it dies before the first flushed write. This image replaces
# /conf/opentv_payload with a /bin/sh wrapper that logs to
# /conf/opentv_wrapper.log (mounts, perms, args) then execs the real
# binary renamed to /conf/opentv_payload.bin. If the wrapper log
# appears, conf-exec works and the ELF fails (and we see why); if it
# doesn't, appmgr cannot exec programs from /conf at all.
#
# Based on the live conf dump (v10) = conf v3 contents. Clears stale
# opentv_payload.log / wget_test.log. Fresh session, apdat0 as the
# first and only UBI attach (proven flow).
# Image: conf_v32.ubifs (3,809,280 B = 0x3a2000, crc32 02dae9c4).

echo OPENTV-CONFV32: begin (ARMED, conf <- conf_v32.ubifs wrapper diag)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv32_began.bin 4

fatload usb 0:auto 0x3300000 conf_v32.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 02dae9c4; then
    echo OPENTV-CONFV32: VERIFIED (crc32 02dae9c4)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v32_conf_ok.bin 4
else
    echo OPENTV-CONFV32: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v32_conf_FAIL.bin 4
fi

echo OPENTV-CONFV32: done
% <- this is end of file symbol
