# OpenTV /conf WRITE v3.6 (full liveness idtv: backdoor + exec stock aurora)
# *** ARMED: WRITES TV FLASH ***
#
# v3.5 telnet-only (no payload/watchdog/UBI) still reboot-looped (~33s, watchdog
# timeout / "wait for IDTV semaphore", COM.NVT.PRIVSERVER.CB context): idtv-slot
# liveness not satisfied. v3.6 keeps telnetd/route-block/heartbeat running in a
# background keeper and execs the stock idtv (/vendor/com.nvt.idtv/aurora.elf) as
# the foreground idtv process so aurora fulfills appmgr/privserver/watchdog
# liveness (semaphore_idtv/appmgr handshake, IPC/CB, watchdog kicks) itself.
# Goal: stable system + persistent root shell (:23) on a fully-live idtv.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v36.ubifs (3,809,280 B = 0x3a2000, crc32 1ce0384d).

echo OPENTV-CONFV36: begin (ARMED, conf <- conf_v36.ubifs liveness)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv36_began.bin 4

fatload usb 0:auto 0x3300000 conf_v36.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 1ce0384d; then
    echo OPENTV-CONFV36: VERIFIED (crc32 1ce0384d)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v36_conf_ok.bin 4
else
    echo OPENTV-CONFV36: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v36_conf_FAIL.bin 4
fi

echo OPENTV-CONFV36: done
% <- this is end of file symbol
