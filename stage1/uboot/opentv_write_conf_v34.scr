# OpenTV /conf WRITE v3.4 (full recovery/debug: telnetd + keepalive + payload capture)
# *** ARMED: WRITES TV FLASH ***
#
# v3.2.1/ap0 hook runs; wrapper v3.3 showed payload exec succeeds but
# payload produced no logs and TV reboot-looped (~33s). v3.4 wrapper:
#  - brings up eth0 + telnetd immediately and keeps idtv alive (loop)
#  - reasserts route-del-default and telnetd periodically
#  - runs payload.bin in background with stdout/stderr -> /conf/opentv_payload.log
# Goal: stable root shell on :23 even if payload misbehaves/crashes.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v34.ubifs (3,809,280 B = 0x3a2000, crc32 94c281c1).

echo OPENTV-CONFV34: begin (ARMED, conf <- conf_v34.ubifs)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv34_began.bin 4

fatload usb 0:auto 0x3300000 conf_v34.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 94c281c1; then
    echo OPENTV-CONFV34: VERIFIED (crc32 94c281c1)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v34_conf_ok.bin 4
else
    echo OPENTV-CONFV34: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v34_conf_FAIL.bin 4
fi

echo OPENTV-CONFV34: done
% <- this is end of file symbol
