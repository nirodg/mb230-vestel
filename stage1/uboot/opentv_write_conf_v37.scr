# OpenTV /conf WRITE v3.7 (full liveness idtv, low-interference keeper)
# *** ARMED: WRITES TV FLASH ***
#
# v3.6: exec'd stock aurora -> appmgr "wait for IDTV semaphore done" (liveness
# gate passed) and aurora rendered briefly (white screens/square), but idtv
# exited -> COM.NVT.PRIVSERVER.CB flood -> watchdog reboot (~20-30s). v3.6 keeper
# also ran udhcpc/ifconfig/MAC/insmod competing with aurora's own network.
# v3.7: let aurora own network/display; background keeper only maintains telnetd
# and gently drops default route (OTA mitigation), then execs stock aurora.
# Goal: stable system + persistent root shell (:23) on a fully-live idtv.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v37.ubifs (3,809,280 B = 0x3a2000, crc32 41fb54c1).

echo OPENTV-CONFV37: begin (ARMED, conf <- conf_v37.ubifs liveness low-if)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv37_began.bin 4

fatload usb 0:auto 0x3300000 conf_v37.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 41fb54c1; then
    echo OPENTV-CONFV37: VERIFIED (crc32 41fb54c1)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v37_conf_ok.bin 4
else
    echo OPENTV-CONFV37: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v37_conf_FAIL.bin 4
fi

echo OPENTV-CONFV37: done
% <- this is end of file symbol
