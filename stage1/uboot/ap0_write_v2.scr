# OpenTV ap0 WRITE script v2  --  *** ARMED: THIS WRITES TV FLASH ***
#
# Track-C v2: overwrite the ap0 volume with ap0_patched_v2.squashfs =
# v1 (insmod ntkethmac.ko fix, already on the TV) + the v2 change in
# run_aurora.sh: CIFS mount+exec replaced by
#   1) /conf/aurora.elf if present (network-free), else
#   2) timeout 20 wget http://$ip_addr:8000/aurora.elf -> exec
#   3) original CIFS path as last resort (harmless)
# Reason: the TV kernel has no crypto for CIFS NTLM auth (round 6,
# ARCHITECTURE.md). Plain HTTP needs none. $ip_addr still comes from
# /conf/remote.txt, so the PC address stays configurable there.
#
# Only the ap0 VOLUME DATA is written (dynamic volume; layout headers,
# volume table, fs0/ap1 volumes and everything signed or boot-critical
# untouched). Restore = ap0_restore.scr (factory image, same channel).
#
# Deploy ONLY as <FAT32 stick root>/kylo_usb_update.scr on explicit go,
# with ap0_patched_v2.squashfs (154,017,792 B) in the stick root.
# PC side must be ready: HTTP server on port 8123 serving aurora.elf
# (python3 -m http.server 8123 -d /srv/mb230cifs) + ufw allow 8123/tcp.
# (Port 8000 was already occupied by another service on this PC.)

echo OPENTV-AP0WRITE2: begin (ARMED, ap0 <- patched v2)

# 1) load the patched v2 image from the FAT stick into RAM
fatload usb 0:auto 0x3300000 ap0_patched_v2.squashfs

# 2) attach UBI on the fs0 mtd partition and update the ap0 volume
ubi part fs0
ubi write 0x3300000 ap0 0x92e2000

# 3) verify: dirty RAM, read the whole volume back, CRC-compare
mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 ap0 0x92e2000
if crc32 0x3300000 0x92e2000 11a83e1b; then
    echo OPENTV-AP0WRITE2: VERIFIED (crc32 11a83e1b)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 ap0_write_v2_ok.bin 4
else
    echo OPENTV-AP0WRITE2: *** CRC MISMATCH - RUN ap0_restore ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 ap0_write_v2_FAIL.bin 4
fi

echo OPENTV-AP0WRITE2: done
% <- this is end of file symbol
