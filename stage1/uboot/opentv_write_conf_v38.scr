# OpenTV /conf WRITE v3.8 (full liveness idtv, stock path/cwd + stdout capture)
# *** ARMED: WRITES TV FLASH ***
#
# v3.7: semaphore done, aurora rendered (white/square) but idtv exited mid-startup
# (COM.NVT.PRIVSERVER.CB flood -> watchdog). v3.8: exec aurora via stock-context
# path /mtd_apexe/board/com.nvt.idtv/aurora.elf with cwd=/mtd_apexe/board (run.sh
# binds ap0 there), keep keeper minimal (telnetd only, no route/ifconfig changes),
# and periodically snapshot /tmp/stdout.all to /conf/opentv_stdout_all.log for
# post-mortem diagnosis of aurora's exit.
# Goal: stable system + persistent root shell (:23) on a fully-live idtv.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v38.ubifs (3,809,280 B = 0x3a2000, crc32 2b48b972).

echo OPENTV-CONFV38: begin (ARMED, conf <- conf_v38.ubifs liveness v38)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv38_began.bin 4

fatload usb 0:auto 0x3300000 conf_v38.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 2b48b972; then
    echo OPENTV-CONFV38: VERIFIED (crc32 2b48b972)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v38_conf_ok.bin 4
else
    echo OPENTV-CONFV38: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v38_conf_FAIL.bin 4
fi

echo OPENTV-CONFV38: done
% <- this is end of file symbol
