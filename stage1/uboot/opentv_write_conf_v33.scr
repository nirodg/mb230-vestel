# OpenTV /conf WRITE v3.3 (wrapper runs via /bin/sh, ELF copied to /tmp)
# *** ARMED: WRITES TV FLASH ***
#
# Pairs with ap0 v3.1 (program=/bin/sh args=/conf/opentv_payload).
# Wrapper v3.3 copies /conf/opentv_payload.bin to /tmp and execs it
# there, so it works even if /conf is mounted noexec. Also logs mount
# info and each step to /conf/opentv_wrapper.log.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v33.ubifs (3,809,280 B = 0x3a2000, crc32 dcd9812b).

echo OPENTV-CONFV33: begin (ARMED, conf <- conf_v33.ubifs)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv33_began.bin 4

fatload usb 0:auto 0x3300000 conf_v33.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 dcd9812b; then
    echo OPENTV-CONFV33: VERIFIED (crc32 dcd9812b)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v33_conf_ok.bin 4
else
    echo OPENTV-CONFV33: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v33_conf_FAIL.bin 4
fi

echo OPENTV-CONFV33: done
% <- this is end of file symbol
