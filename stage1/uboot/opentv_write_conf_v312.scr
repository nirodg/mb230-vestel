# OpenTV /conf WRITE v3.12 (v3.11 env-fix + telnetd PTY fix: mount devpts)
# *** ARMED: WRITES TV FLASH ***
#
# v3.11 result: STABLE SYSTEM -- aurora fully alive with stock env restored
# (semaphore done, OOIF/browser_dir loaded, UI running, no SIGABRT for 3+ min).
# Remaining issue: telnetd accepts :23 but resets connections -- /dev/pts is not
# mounted on this system (see v3.6 mount log), so busybox telnetd cannot allocate
# a PTY for the shell session. v3.12: keeper mounts devpts at /dev/pts before
# starting telnetd; also starts a busybox nc -ll -e /bin/sh fallback on :2323.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v312.ubifs (3,809,280 B = 0x3a2000, crc32 155e4c25).

echo OPENTV-CONFV312: begin (ARMED, conf <- conf_v312.ubifs devpts-fix)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv312_began.bin 4

fatload usb 0:auto 0x3300000 conf_v312.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 155e4c25; then
    echo OPENTV-CONFV312: VERIFIED (crc32 155e4c25)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v312_conf_ok.bin 4
else
    echo OPENTV-CONFV312: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v312_conf_FAIL.bin 4
fi

echo OPENTV-CONFV312: done
% <- this is end of file symbol
