# OpenTV ap0 WRITE v3.2 -- *** ARMED: WRITES TV FLASH ***
#
# Fix for v3.1 failure: appmgr passes argv[0]=app name ("idtv") to execvp.
# BusyBox multicall dispatches on argv0, so program=/bin/sh was invoked as
# applet "idtv" -> "idtv: applet not found" and the hook never ran.
# v3.2 bakes /opentv_shim (tiny static ARM ELF in ap0, exec-able squashfs)
# that execve("/bin/sh", {"sh","/conf/opentv_payload",NULL}, envp),
# ignoring appmgr's argv. [idtv] program=/opentv_shim, args=, name=idtv.
# Pairs with existing conf v3.3 (wrapper copies payload ELF to /tmp).
# Image: ap0_patched_v32.squashfs (154,021,888 B = 0x92e3000, crc32 063d9ac9)
# Only ap0 volume data written; layout/vtbl/other volumes untouched.
# Restore = ap0_restore.scr (factory).

echo OPENTV-AP0WRITE32: begin (ARMED, ap0 <- v3.2 shim-launcher)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 ap0v32_began.bin 4

fatload usb 0:auto 0x3300000 ap0_patched_v32.squashfs
ubi part fs0
ubi write 0x3300000 ap0 0x92e3000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 ap0 0x92e3000
if crc32 0x3300000 0x92e3000 063d9ac9; then
    echo OPENTV-AP0WRITE32: VERIFIED (crc32 063d9ac9)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v32_ap0_ok.bin 4
else
    echo OPENTV-AP0WRITE32: *** CRC MISMATCH - RUN ap0_restore ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v32_ap0_FAIL.bin 4
fi

echo OPENTV-AP0WRITE32: done
% <- this is end of file symbol
