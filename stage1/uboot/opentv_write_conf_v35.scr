# OpenTV /conf WRITE v3.5 (telnet-only: stable root shell, no payload/watchdog/UBI reads)
# *** ARMED: WRITES TV FLASH ***
#
# v3.4 (telnetd+keepalive, payload in bg) still reboot-looped (watchdog timeout /
# COM.NVT.PRIVSERVER.CB) with :23 not stable. v3.5 is minimal: bring up eth0,
# start telnetd immediately, keep idtv alive in a simple loop and heartbeat to
# /conf/opentv_wrapper.log. No payload binary exec, no /dev/watchdog, no UBI reads.
# Goal: obtain a stable root shell to debug/customize userspace live.
# Fresh session, apdat0 as the first and only UBI attach (proven).
# Image: conf_v35.ubifs (3,809,280 B = 0x3a2000, crc32 a6bc4589).

echo OPENTV-CONFV35: begin (ARMED, conf <- conf_v35.ubifs telnet-only)

mw.l 0x5000000 0x5a5a5a5a
fatwrite usb 0:auto 0x5000000 confv35_began.bin 4

fatload usb 0:auto 0x3300000 conf_v35.ubifs
ubi part apdat0
ubi write 0x3300000 apdat0 0x3a2000

mw.l 0x3300000 0x00000000 1
ubi read 0x3300000 apdat0 0x3a2000
if crc32 0x3300000 0x3a2000 a6bc4589; then
    echo OPENTV-CONFV35: VERIFIED (crc32 a6bc4589)
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 v35_conf_ok.bin 4
else
    echo OPENTV-CONFV35: *** CRC MISMATCH ***
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 v35_conf_FAIL.bin 4
fi

echo OPENTV-CONFV35: done
% <- this is end of file symbol
